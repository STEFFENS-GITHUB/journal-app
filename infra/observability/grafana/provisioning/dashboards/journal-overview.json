                    "1": { "text": "UP", "color": "green", "index": 0 }
                  }
                },
                {
                  "type": "special",
                  "options": {
                    "match": "null",
                    "result": { "text": "NO DATA", "color": "#7A7A7A", "index": 2 }
                  }
                }
