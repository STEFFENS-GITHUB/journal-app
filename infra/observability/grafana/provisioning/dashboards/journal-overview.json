{
  "uid": "journal-overview",
  "title": "Journal Overview",
  "tags": ["journal"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Reachability",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": [
        {
          "type": "stat",
          "title": "MySQL Reachable",
          "description": "mysql_up — the exporter could open a connection to MySQL.",
          "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
          "datasource": { "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "mysql_up","instant": true }
          ],
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": { "text": "DOWN", "index": 1 },
                    "1": { "text": "UP", "index": 0 }
                  }
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "green", "value": 1 }
                ]
              },
              "noValue": "NO DATA"
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "colorMode": "background",
            "graphMode": "none",
            "textMode": "value",
            "justifyMode": "auto",
            "orientation": "auto",
            "wideLayout": true
          }
