{
  "uid": "journal-traffic",
  "title": "Journal Traffic",
  "tags": ["journal"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(journal_requests_total, route)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Total API Request Rate",
      "description": "Per-second rate of journal_requests_total. Not filtered by the Route variable.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {"refId": "A","expr": "sum(rate(journal_requests_total[$__rate_interval]))","legendFormat": "total"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "API Request Rate by Route",
      "description": "Per-second rate of journal_requests_total, broken down by route. Filtered by the Route variable.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {"refId": "A","expr": "sum by (route) (rate(journal_requests_total{route=~\"$route\"}[$__rate_interval]))","legendFormat": "{{route}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "API Request Rate by Status Code",
      "description": "Per-second rate of journal_requests_total, broken down by HTTP status code. Filtered by the Route variable.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {"refId": "A","expr": "sum by (status_code) (rate(journal_requests_total{route=~\"$route\"}[$__rate_interval]))","legendFormat": "{{status_code}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "p95 Latency by Route",
      "description": "95th percentile of journal_request_duration_seconds, by route. Estimated from histogram buckets. Filtered by the Route variable.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 27 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {"refId": "A","expr": "histogram_quantile(0.95, sum by (le, route) (rate(journal_request_duration_seconds_bucket{route=~\"$route\"}[$__rate_interval])))","legendFormat": "{{route}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
