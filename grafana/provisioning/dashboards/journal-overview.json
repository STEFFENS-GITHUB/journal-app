{
  "uid": "journal-overview",
  "title": "Journal Overview",
  "tags": ["journal"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "MySQL Reachable",
      "description": "mysql_up — the exporter could open a connection to MySQL.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "mysql_up","instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "index": 1 },
                "1": { "text": "UP", "index": 0 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Redis Reachable",
      "description": "redis_up — the exporter could open a connection to Redis.",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {"refId": "A","expr": "redis_up","instant": true}
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "index": 1 },
                "1": { "text": "UP", "index": 0 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "API Reachable",
      "description": "up{job=\"journal-api\"} — Prometheus successfully scraped the API's /metrics.",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {"refId": "A","expr": "up{job=\"journal-api\"}","instant": true}
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "index": 1 },
                "1": { "text": "UP", "index": 0 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "state-timeline",
      "title": "Reachability History",
      "description": "UP/DOWN over time. Blank means no data was collected at all — Prometheus was not scraping.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {"refId": "A","expr": "mysql_up","legendFormat": "MySQL"},
        {"refId": "B","expr": "redis_up","legendFormat": "Redis"},
        {"refId": "C","expr": "up{job=\"journal-api\"}","legendFormat": "API"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 1 },
                "1": { "text": "UP", "color": "green", "index": 0 }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": { "text": "NO DATA", "color": "#7A7A7A", "index": 2 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "noValue": "NO DATA",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    }
  ]
}
